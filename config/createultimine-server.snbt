			"createframed:item_application/bound_cardboard/yellow": true
			"create:item_application/andesite_casing_from_wood": true
			"createframed:item_application/bound_cardboard/lime": true
			"createframed:item_application/bound_cardboard/red": true
			"createcasing:item_application/creative_casing": true
			"createframed:item_application/bound_cardboard/brown": true
			"createframed:item_application/bound_cardboard/dye_depot/verdant": true
			"createframed:item_application/bound_cardboard/black": true
