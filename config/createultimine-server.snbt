			"createcasing:item_application/zinc_casing": true
			"createframed:item_application/bound_cardboard/dye_depot/forest": true
			"createframed:item_application/bound_cardboard/cyan": true
			"createaddition:compat/immersiveengineering/item_application/leaded_concrete": true
			"createframed:item_application/bound_cardboard/dye_depot/rose": true
			"createframed:item_application/bound_cardboard/blue": true
			"createframed:item_application/bound_cardboard/orange": true
			"createframed:item_application/bound_cardboard/dye_depot/coral": true
